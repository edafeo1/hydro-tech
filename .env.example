# Set these before the final production build on your domain.
SITE_ORIGIN=https://hydrotecbuildingprotectiongroup.com.au
SITE_INDEXABLE=0
# The deployed HTTP API endpoint; leave empty only for the email-app fallback.
ENQUIRY_ENDPOINT=
# Mark the staging form as a test while routing it to the temporary test inbox.
ENQUIRY_TEST_MODE=0

# Optional public Search Console HTML verification token, issued by Google.
# Domain property verification uses a DNS TXT record instead. Never put credentials here.
GOOGLE_SITE_VERIFICATION=
